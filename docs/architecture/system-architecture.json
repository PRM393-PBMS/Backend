  "cards": [
    { "dot": "cyan", "title": "Synchronous request path", "items": ["Flutter UI → Dio → HTTPS REST → Nest controllers → guards → domain services", "Domain services use Prisma through the Supabase Session Pooler to PostgreSQL", "Access and refresh tokens are retained on the mobile device; backend secrets remain in environment configuration"] },
    { "dot": "violet", "title": "Async, batch, and external callbacks", "items": ["PayOS creates payment links through outbound HTTPS; its signed webhook returns to POST /api/payments/payos-webhook", "Reservation cron runs every minute inside the same NestJS process — it is not a separate worker", "Resend and Plate Recognizer are direct outbound HTTPS integrations; no queue, stream, or event bus is committed"] },
    { "dot": "amber", "title": "Operational limits", "items": ["OTP Map and UPLOAD_DIR are process-local; uploads are not object storage and OTP is lost on restart", "UptimeRobot checks HTTP liveness only; no committed centralized logs, metrics, tracing, alerting, container orchestration, cache, or search", "Build/deployment is documented for Render; no CI/CD workflow is committed"] }
