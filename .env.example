# PRM393 backend — cấu hình mẫu có thể commit.
# Copy sang .env và thay REPLACE_WITH_* bằng thông tin của bạn.
# Không lưu mật khẩu/API key thật trong .env.example.
# App nạp .env từ thư mục chạy trước khi khởi tạo Nest providers.
# Chạy từ root repo: npm start (Node 22+; máy hiện tại dùng Node 26).
# Biến môi trường của hệ điều hành có thể ghi đè giá trị từ file.

# === ĐANG ĐƯỢC CODE SỬ DỤNG ===
# development | test | production; development bật Prisma query logging.
NODE_ENV=development
PORT=3000
# Swagger hiện cố định tại http://localhost:3000/api/docs.
# Optional. Hiện trên dropdown Servers của Swagger. Để trống = cùng origin với trang /api/docs
# (local: http://localhost:3000, Render: https://<service>.onrender.com). Không có dấu / cuối.
PUBLIC_API_URL=

# PostgreSQL trên Supabase: lấy Session Pooler URL trong Dashboard → Connect.
# Dùng cùng DATABASE_URL cho local và Render; không commit URL/mật khẩu.
# Database phải tồn tại; URL không tự tạo database hoặc bảng.
# URL-encode ký tự đặc biệt trong username/password, ví dụ @ thành %40.
DATABASE_URL="postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/prm393_db?schema=public"

# Tạo HAI secret độc lập, lưu trong .env. Chạy lệnh sau hai lần:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_ACCESS_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_RANDOM_REFRESH_SECRET"
# Access TTL 15 phút, refresh TTL 7 ngày và bcrypt rounds 12 đang nằm trong code.
# Thêm biến TTL/rounds ở đây sẽ chưa thay đổi hành vi ứng dụng.

# Origin frontend Vite local, không có path hoặc dấu / cuối.
# Session Pooler Supabase là endpoint công khai IPv4; giữ sslmode=require trong DATABASE_URL.
CORS_ORIGIN="http://localhost:5173"

# Resend Emails API: OTP đăng ký và reset mật khẩu. Local và Render cùng kênh HTTPS.
# Thiếu RESEND_API_KEY hoặc MAIL_FROM → sendOtpEmail ném lỗi cấu hình (không timeout SMTP).
# Chi tiết: docs/resend-setup.md. Không dán API key thật vào file này.
RESEND_API_KEY=
# From trên domain brand. Resend chỉ gửi được sau khi neoforcelab.com Verified (DNS).
MAIL_FROM=otp@neoforcelab.com
MAIL_SENDER_NAME="NEO Force Lab"
MAIL_REPLY_TO=otp@neoforcelab.com
# Màu header HTML, phải là mã HEX #RRGGBB. Để trống sẽ dùng #0F766E.
MAIL_BRAND_COLOR="#0F766E"

# PayOS: tạo liên kết thanh toán và nhận webhook `/api/payments/payos-webhook`.
# Thiếu 3 credential → tạo thanh toán online thất bại lúc runtime, không giả lập charge.
PAYOS_CLIENT_ID="REPLACE_WITH_PAYOS_CLIENT_ID"
PAYOS_API_KEY="REPLACE_WITH_PAYOS_API_KEY"
PAYOS_CHECKSUM_KEY="REPLACE_WITH_PAYOS_CHECKSUM_KEY"
PAYOS_RETURN_URL="http://localhost:5173/payment-success"
PAYOS_CANCEL_URL="http://localhost:5173/payment-cancel"

# Plate Recognizer: OCR biển số trên `/api/ParkingOperation/upload-and-recognize-plate`.
PLATE_RECOGNIZER_API_KEY="REPLACE_WITH_PLATE_RECOGNIZER_API_TOKEN"
PLATE_RECOGNIZER_ENDPOINT="https://api.platerecognizer.com/v1/plate-reader/"
PLATE_RECOGNIZER_REGIONS="vn"
PLATE_RECOGNIZER_MINIMUM_CONFIDENCE=0.75

# Ảnh check-in / proof. Static URL dạng `/uploads/...`.
UPLOAD_DIR="./public/uploads"
