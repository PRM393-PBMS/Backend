# Cấu hình mẫu có thể commit.
# Copy sang .env rồi điền thông tin riêng.
# Không commit file .env hoặc API key thật.
#
# Chạy bằng Docker:
# docker compose up -d --build
#
# Compose ghi đè DATABASE_URL, REDIS_URL, NODE_ENV, PORT và UPLOAD_DIR
# cho backend để kết nối các container.

NODE_ENV=development
PORT=3000

# URL công khai hiển thị trong Swagger; để trống dùng cùng origin.
PUBLIC_API_URL=

# PostgreSQL trong Docker.
# Dùng mật khẩu dài gồm chữ và số với cấu hình Compose hiện tại.
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD

# Dùng khi backend chạy trực tiếp trên máy.
# Compose ghi đè bằng URL kết nối container postgres.
# Chạy trực tiếp cần PostgreSQL có mở cổng 5432 trên máy.
DATABASE_URL="postgresql://pbms:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/pbms?schema=public"

# Tạo hai khóa riêng bằng cách chạy lệnh này hai lần:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_REFRESH_SECRET

# Origin của frontend.
CORS_ORIGIN="http://localhost:5173"

# Redis lưu OTP.
# Compose ghi đè bằng redis://redis:6379.
# Chạy backend trực tiếp cần Redis có mở cổng 6379 trên máy.
REDIS_URL=redis://localhost:6379

# Resend gửi OTP đăng ký và đặt lại mật khẩu.
# Điền key thật vào .env; giữ trống trong .env.example.
RESEND_API_KEY=

# Địa chỉ gửi phải thuộc domain đã xác minh trong tài khoản Resend.
MAIL_FROM=otp@neoforcelab.com
MAIL_SENDER_NAME="NEO Force Lab"
MAIL_REPLY_TO=otp@neoforcelab.com
MAIL_BRAND_COLOR="#0F766E"

# PayOS: điền credential thật trong .env nếu dùng thanh toán online.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL="http://localhost:5173/payment-success"
PAYOS_CANCEL_URL="http://localhost:5173/payment-cancel"

# Plate Recognizer: điền API key trong .env nếu dùng OCR biển số.
PLATE_RECOGNIZER_API_KEY=
PLATE_RECOGNIZER_ENDPOINT="https://api.platerecognizer.com/v1/plate-reader/"
PLATE_RECOGNIZER_REGIONS="vn"
PLATE_RECOGNIZER_MINIMUM_CONFIDENCE=0.75

# Thư mục ảnh upload.
# Compose ghi đè bằng /app/public/uploads và lưu vào volume.
UPLOAD_DIR="./public/uploads"